{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The static site, and a small Worker for the multiplayer's signalling:
  // assets are served first, the Worker only sees /signal/<room>.
  "name": "jumpsim",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist"
  },
  // One Durable Object per room. SQLite-backed: the only kind on the Free plan.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // How the picture runs in the browsers (POST /perf): frame rate, phase, device.
  // Queried with the SQL API, dataset jumpsim_perf (see src/net/perfSchema.ts).
  "analytics_engine_datasets": [{ "binding": "PERF", "dataset": "jumpsim_perf" }],
  // Branches other than main get their own Preview URL (`wrangler preview`).
  // Bindings are not inherited: each Preview gets its own rooms.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
    },
    // Previews report to their own dataset, not mixed with the live site's.
    "analytics_engine_datasets": [{ "binding": "PERF", "dataset": "jumpsim_perf_preview" }]
  }
}
