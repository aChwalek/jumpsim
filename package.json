{
  "name": "lowpull",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:signal": "mkdir -p dist && wrangler dev --port 8787 --local-upstream 127.0.0.1:5173",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p worker",
    "deploy": "tsc --noEmit && npm run typecheck:worker && vite build --sourcemap false && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "better-auth": "^1.7.23",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
